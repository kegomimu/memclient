{
  "name": "aidarkolbaev/memclient",
  "type": "library",
  "description": "Pure PHP Memcached client",
  "homepage": "https://github.com/aidarkolbaev/memclient",
  "license": "MIT",
  "authors": [
    {
      "name": "kegomimu",
      "email": "velvet-cadet-shed@duck.com"
    },
    {
      "name": "Aidar Kolbaev",
      "email": "aidarkolbaew@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-sockets": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "phpunit/phpunit": "^9.6 || ^10.5"
  },
  "autoload": {
    "classmap": [
      "MClient/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "phpcs": "phpcs --standard=PSR2 MClient/ tests/"
  }
}